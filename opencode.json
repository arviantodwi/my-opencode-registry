{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "mcp": {
    "servers": {
      "pencil": {
        "type": "local",
        "command": [
          "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
          "--app",
          "desktop",
          "--agent",
          "openCodeCLI"
        ],
        "disabled": false
      }
    }
  },
  "websearch": {
    "provider": "random"
  }
}
