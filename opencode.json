{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "mcp": {
    "servers": {
      "pencil": {
        "type": "local",
        "command": [
          "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
          "--app",
          "desktop",
          "--agent",
          "openCodeCLI"
        ],
        "disabled": false
      },
      "figcraft": {
        "type": "local",
        "command": [
          "figcraft-cli",
          "mcp",
          "--attach",
          "7979"
        ],
        "disabled": false
      }
    }
  },
  "plugins": [
    {
      "package": "github:arviantodwi/arviantodwi#semver:^1.0.0::path:packages/activity-plugin",
      "options": {
        "url": "https://api.arvian.to/activity/turns",
        "token": "{file:~/.agent-activity.token}"
      }
    }
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "cloudflare-ai-gateway",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "cloudflare-workers-ai",
      "effect": "deny"
    }
  ],
  "disabled_providers": [
    "cloudflare-ai-gateway",
    "cloudflare-workers-ai"
  ],
  "websearch": {
    "provider": "random"
  }
}
