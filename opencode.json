{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "model": "opencode-go/glm-5.3-flash#high"
    },
    "plan": {
      "model": "opencode-go/glm-5.3-flash#max"
    }
  },
  "default_agent": "plan",
  "watcher": {
    "ignore": [
      ".git/**",
      ".next/**",
      "dist/**",
      "node_modules/**",
      ".env",
      "package-lock.json",
      "pnpm-lock.yaml"
    ]
  },
  "mcp": {
    "pencil": {
      "command": [
        "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "websearch": {
    "provider": "random"
  },
  "plugins": [
    "github:vercel/vercel-plugin"
  ]
}