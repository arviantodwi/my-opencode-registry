{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.5
  },
  "diffs": {
    "view": "auto",
    "wrap": "word"
  },
  "prompt": {
    "paste": "compact"
  },
  "scroll": {
    "speed": 3
  },
  "session": {
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "autoaccept",
    "scrollbar": true,
    "sidebar": "hide",
    "thinking": "show",
    "verbosity": "low"
  },
  "tabs": {
    "indicators": "status",
    "layout": "horizontal",
    "mode": "auto",
    "scope": "cwd"
  },
  "terminal": {
    "copy": "select",
    "title": true
  },
  "theme": {
    "mode": "system",
    "name": "catppuccin"
  }
}