{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "verbosity": "low",
    "permissions": "prompt",
    "grouping": "auto"
  },
  "animations": true,
  "tabs": {
    "mode": "on",
    "indicators": "status",
    "layout": "horizontal"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.5
  },
  "terminal": {
    "title": true
  },
  "prompt": {
    "paste": "compact"
  },
  "highlights": true
}
