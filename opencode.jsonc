{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    }
  },
  "default_agent": "plan",
  "provider": {
    "ollama_local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "llama3.2": {}
      }
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".next/**",
      "dist/**",
      "node_modules/**",
      ".env",
      "package-lock.json",
      "pnpm-lock.yaml",
    ],
  },
  "mcp": {
    "inkeep": {
      "type": "remote",
      "url": "https://mcp.inkeep.com/zod/mcp",
      "enabled": false,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
      "enabled": false,
    },
    "figma-bridge": {
      "type": "local",
      "command": ["npx", "-y", "@gethopp/figma-mcp-bridge"],
      "enabled": false,
    },
    "TalkToFigma": {
      "type": "local",
      "command": ["bunx", "cursor-talk-to-figma-mcp@latest"],
      "enabled": false,
    },
    "Playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false,
    },
  },
  "plugin": ["@franlol/opencode-md-table-formatter@0.0.3"],
}
